# Copy to .env.local for local runs. Vercel needs the same names (docs/SETUP.md, step 4).

# Phase 0: Supabase and access
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
APP_URL=http://localhost:3000
ALLOWED_EMAIL=

# Set to 1 in CI and cloud sessions that build without real secrets
SKIP_ENV_VALIDATION=

# Phase 2: sync
CRON_SECRET=
TOKEN_ENCRYPTION_KEY=
UW_OPENDATA_API_KEY=

# Phase 3: Claude
ANTHROPIC_API_KEY=
# Only if the key is not scoped to a workspace: the workspace id from the Claude Console
ANTHROPIC_WORKSPACE_ID=
AI_MONTHLY_BUDGET_USD=15
MODEL_EXTRACT=claude-sonnet-5
MODEL_CLEANUP=claude-sonnet-5
MODEL_ASK=claude-sonnet-5
MODEL_ASK_DEEP=claude-opus-5

# Phase 4: Google Calendar and the Apps Script bridge
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INGEST_WEBHOOK_SECRET=

# Local only: never add these to Vercel
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Optional
MS_CLIENT_ID=
MS_TENANT=organizations
VOYAGE_API_KEY=
